<!doctype html>
<html lang="en" class="layout-menu-fixed layout-compact" data-assets-path="/assets/"
  data-template="vertical-menu-template-free">

<head>
  <%- include('partials/head') %>
    <link rel="stylesheet" href="/assets/vendor/libs/apex-charts/apex-charts.css" />
</head>

<body>
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">

      <%- include('partials/sidebar') %>

        <div class="layout-page">
          <%- include('partials/navbar') %>

            <div class="content-wrapper">
              <div class="container-xxl flex-grow-1 container-p-y">
                <div class="row gy-6">

                  <!-- Congratulations Card -->
                  <div class="col-md-12 col-lg-4">
                    <div class="card">
                      <div class="card-body text-nowrap">
                        <h5 class="card-title mb-0 flex-wrap text-nowrap">Congratulations Admin! 🎉</h5>
                        <p class="mb-2">Best seller of the month</p>
                        <h4 class="text-primary mb-0">$42.8k</h4>
                        <p class="mb-2">78% of target 🚀</p>
                        <a href="/users/view-user" class="btn btn-sm btn-primary">View Users</a>
                      </div>
                      <img src="/assets/img/illustrations/trophy.png" class="position-absolute bottom-0 end-0 me-5 mb-5"
                        width="83" alt="trophy" />
                    </div>
                  </div>

                  <!-- Transactions Stats -->
                  <div class="col-lg-8">
                    <div class="card h-100">
                      <div class="card-header">
                        <div class="d-flex align-items-center justify-content-between">
                          <h5 class="card-title m-0 me-2">Transactions</h5>
                        </div>
                        <p class="small mb-0"><span class="h6 mb-0">Total 48.5% Growth</span> this month</p>
                      </div>
                      <div class="card-body pt-lg-10">
                        <div class="row g-6">
                          <div class="col-md-3 col-6">
                            <div class="d-flex align-items-center">
                              <div class="avatar">
                                <div class="avatar-initial bg-primary rounded shadow-xs">
                                  <i class="icon-base ri ri-pie-chart-2-line icon-24px"></i>
                                </div>
                              </div>
                              <div class="ms-3">
                                <p class="mb-0">Sales</p>
                                <h5 class="mb-0">245k</h5>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-3 col-6">
                            <div class="d-flex align-items-center">
                              <div class="avatar">
                                <div class="avatar-initial bg-success rounded shadow-xs">
                                  <i class="icon-base ri ri-group-line icon-24px"></i>
                                </div>
                              </div>
                              <div class="ms-3">
                                <p class="mb-0">Customers</p>
                                <h5 class="mb-0">12.5k</h5>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-3 col-6">
                            <div class="d-flex align-items-center">
                              <div class="avatar">
                                <div class="avatar-initial bg-warning rounded shadow-xs">
                                  <i class="icon-base ri ri-macbook-line icon-24px"></i>
                                </div>
                              </div>
                              <div class="ms-3">
                                <p class="mb-0">Products</p>
                                <h5 class="mb-0">1.54k</h5>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-3 col-6">
                            <div class="d-flex align-items-center">
                              <div class="avatar">
                                <div class="avatar-initial bg-info rounded shadow-xs">
                                  <i class="icon-base ri ri-money-dollar-circle-line icon-24px"></i>
                                </div>
                              </div>
                              <div class="ms-3">
                                <p class="mb-0">Revenue</p>
                                <h5 class="mb-0">$88k</h5>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Weekly Overview Chart -->
                  <div class="col-xl-4 col-md-6">
                    <div class="card">
                      <div class="card-header">
                        <h5 class="mb-1">Weekly Overview</h5>
                        <p class="mb-0 small">Total 85.4k Sales</p>
                      </div>
                      <div class="card-body">
                        <div id="weeklyOverviewChart"></div>
                        <div class="d-flex justify-content-between align-items-center mt-4">
                          <div>
                            <h4 class="mb-0">45%</h4>
                            <p class="mb-0">Your sales performance is 45% 😎 better compared to last month</p>
                          </div>
                          <a href="javascript:void(0);" class="btn btn-primary btn-sm">Details</a>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Total Revenue Chart -->
                  <div class="col-xl-8 col-md-6">
                    <div class="card">
                      <div class="card-header d-flex justify-content-between">
                        <h5 class="mb-0">Total Revenue</h5>
                      </div>
                      <div class="card-body">
                        <div id="totalRevenueChart"></div>
                      </div>
                    </div>
                  </div>

                  <!-- Quick Stats Row -->
                  <div class="col-xl-4 col-md-6">
                    <div class="card">
                      <div class="card-header">
                        <h5 class="card-title mb-0">Quick Stats</h5>
                      </div>
                      <div class="card-body">
                        <ul class="list-group list-group-flush">
                          <li class="list-group-item d-flex justify-content-between px-0">
                            <span><i class="ri ri-user-line me-2 text-primary"></i> Total Users</span>
                            <strong>1,245</strong>
                          </li>
                          <li class="list-group-item d-flex justify-content-between px-0">
                            <span><i class="ri ri-shopping-cart-line me-2 text-success"></i> Orders</span>
                            <strong>8,258</strong>
                          </li>
                          <li class="list-group-item d-flex justify-content-between px-0">
                            <span><i class="ri ri-money-dollar-circle-line me-2 text-warning"></i> Revenue</span>
                            <strong>$84.6k</strong>
                          </li>
                          <li class="list-group-item d-flex justify-content-between px-0">
                            <span><i class="ri ri-star-line me-2 text-info"></i> Reviews</span>
                            <strong>4.5/5</strong>
                          </li>
                        </ul>
                      </div>
                    </div>
                  </div>

                  <!-- Recent Activity -->
                  <div class="col-xl-8 col-md-6">
                    <div class="card">
                      <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Recent Users</h5>
                        <a href="/users/view-user" class="btn btn-sm btn-outline-primary">View All</a>
                      </div>
                      <div class="table-responsive">
                        <table class="table table-hover mb-0">
                          <thead>
                            <tr>
                              <th>User</th>
                              <th>Role</th>
                              <th>Status</th>
                            </tr>
                          </thead>
                          <tbody>
                            <tr>
                              <td>
                                <div class="d-flex align-items-center">
                                  <img src="/assets/img/avatars/1.png" class="rounded-circle me-2" width="32" />
                                  <span>John Doe</span>
                                </div>
                              </td>
                              <td><span class="badge bg-label-primary">Admin</span></td>
                              <td><span class="badge bg-label-success">Active</span></td>
                            </tr>
                            <tr>
                              <td>
                                <div class="d-flex align-items-center">
                                  <img src="/assets/img/avatars/2.png" class="rounded-circle me-2" width="32" />
                                  <span>Jane Smith</span>
                                </div>
                              </td>
                              <td><span class="badge bg-label-warning">Editor</span></td>
                              <td><span class="badge bg-label-success">Active</span></td>
                            </tr>
                            <tr>
                              <td>
                                <div class="d-flex align-items-center">
                                  <img src="/assets/img/avatars/3.png" class="rounded-circle me-2" width="32" />
                                  <span>Bob Wilson</span>
                                </div>
                              </td>
                              <td><span class="badge bg-label-info">User</span></td>
                              <td><span class="badge bg-label-secondary">Inactive</span></td>
                            </tr>
                          </tbody>
                        </table>
                      </div>
                    </div>
                  </div>

                </div>
              </div>
              <div class="content-backdrop fade"></div>
            </div>
        </div>
    </div>
    <div class="layout-overlay layout-menu-toggle"></div>
  </div>

  <%- include('partials/scripts') %>
    <script src="/assets/vendor/libs/apex-charts/apexcharts.js"></script>
    <script src="/assets/js/dashboards-analytics.js"></script>
</body>

</html>