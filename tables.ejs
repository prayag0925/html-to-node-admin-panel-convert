<!doctype html>
<html lang="en" class="layout-menu-fixed layout-compact" data-assets-path="/assets/" data-template="vertical-menu-template-free">
<head>
  <%- include('partials/head') %>
</head>

<body>
  <div class="layout-wrapper layout-content-navbar">
    <div class="layout-container">

      <%- include('partials/sidebar') %>

      <div class="layout-page">
        <%- include('partials/navbar') %>

        <div class="content-wrapper">
          <div class="container-xxl flex-grow-1 container-p-y">

            <h4 class="py-3 mb-4">
              <span class="text-muted fw-light">Dashboard /</span> Tables
            </h4>

            <div class="card">
              <h5 class="card-header">Basic Table</h5>
              <div class="table-responsive text-nowrap">
                <table class="table">
                  <thead>
                    <tr>
                      <th>Project</th>
                      <th>Client</th>
                      <th>Status</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody class="table-border-bottom-0">
                    <% rows.forEach(function(row) { %>
                    <tr>
                      <td>
                        <i class="icon-base ri <%= row.icon %> icon-22px <%= row.iconColor %> me-3"></i>
                        <span><%= row.project %></span>
                      </td>
                      <td><%= row.client %></td>
                      <td>
                        <span class="badge rounded-pill bg-label-<%= row.statusColor %> me-1">
                          <%= row.status %>
                        </span>
                      </td>
                      <td>
                        <div class="dropdown">
                          <button type="button" class="btn p-0 dropdown-toggle hide-arrow shadow-none" data-bs-toggle="dropdown">
                            <i class="icon-base ri ri-more-2-line icon-18px"></i>
                          </button>
                          <div class="dropdown-menu">
                            <a class="dropdown-item" href="javascript:void(0);">
                              <i class="icon-base ri ri-pencil-line icon-18px me-1"></i> Edit
                            </a>
                            <a class="dropdown-item" href="javascript:void(0);">
                              <i class="icon-base ri ri-delete-bin-6-line icon-18px me-1"></i> Delete
                            </a>
                          </div>
                        </div>
                      </td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>

          </div>
          <div class="content-backdrop fade"></div>
        </div>
      </div>
    </div>
    <div class="layout-overlay layout-menu-toggle"></div>
  </div>

  <%- include('partials/scripts') %>
</body>
</html>
